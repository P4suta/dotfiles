    "Platforms": {
      "type": "object",
      "properties": {
        "linux": {
          "anyOf": [
            {
              "$ref": "#/$defs/Linux"
            },
            {
              "type": "null"
            }
          ]
        },
        "mac": {
          "anyOf": [
            {
              "$ref": "#/$defs/Mac"
            },
            {
              "type": "null"
            }
          ]
        },
        "windows": {
          "anyOf": [
            {
              "$ref": "#/$defs/Windows"
