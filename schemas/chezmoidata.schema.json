{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data",
  "description": "Every key a data file may hold.",
  "type": "object",
  "properties": {
    "coderabbit": {
      "anyOf": [
        {
          "$ref": "#/$defs/Coderabbit"
        },
        {
          "type": "null"
        }
      ]
    },
    "contrast": {
      "description": "The foreground and background palette names that some theme draws text with, each of which keeps a text contrast of 4.5:1.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/ContrastPair"
      }
    },
    "domyjob": {
      "anyOf": [
        {
          "$ref": "#/$defs/Domyjob"
        },
        {
          "type": "null"
        }
      ]
    },
    "herdr_agent": {
      "anyOf": [
        {
          "$ref": "#/$defs/HerdrAgent"
        },
        {
          "type": "null"
        }
      ]
    },
    "mise": {
      "description": "The mise release that every host installs before any other step.",
      "anyOf": [
        {
          "$ref": "#/$defs/MiseRelease"
        },
        {
          "type": "null"
        }
      ]
    },
    "modern": {
      "description": "The modern command-line tools that replace legacy ones for agents, pinned on every profile.",
      "anyOf": [
        {
          "$ref": "#/$defs/Modern"
        },
        {
          "type": "null"
        }
      ]
    },
    "ocaml": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ocaml"
        },
        {
          "type": "null"
        }
      ]
    },
    "palette": {
      "description": "The one palette every themed target renders its colors from.",
      "anyOf": [
        {
          "$ref": "#/$defs/Palette"
        },
        {
          "type": "null"
        }
      ]
    },
    "platforms": {
      "anyOf": [
        {
          "$ref": "#/$defs/Platforms"
        },
        {
          "type": "null"
        }
      ]
    },
    "profiles": {
      "description": "Named sets of profiles.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "retired": {
      "description": "Retired targets that the profiles of the named set remove.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "scripts": {
      "description": "Setup launchers that only the profiles of the named set run, which `just gen` writes from the setup steps.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "shared_tools": {
      "description": "The tools mise installs on every profile.",
      "anyOf": [
        {
          "$ref": "#/$defs/SharedTools"
        },
        {
          "type": "null"
        }
      ]
    },
    "shell": {
      "description": "The interactive behavior every shell a profile configures renders in its own syntax.",
      "anyOf": [
        {
          "$ref": "#/$defs/Shell"
        },
        {
          "type": "null"
        }
      ]
    },
    "targets": {
      "description": "Targets that only the profiles of the named set receive.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Artifact": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Brew": {
      "type": "object",
      "properties": {
        "casks": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "formulae": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "Chat": {
      "type": "object",
      "properties": {
        "peers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "peers"
      ]
    },
    "Chord": {
      "description": "A key chord that every shell's line editor can bind.",
      "type": "string",
      "enum": [
        "alt+left",
        "alt+right",
        "alt+b",
        "alt+f",
        "alt+backspace",
        "ctrl+left",
        "ctrl+right",
        "ctrl+a",
        "ctrl+e",
        "ctrl+k",
        "ctrl+u",
        "ctrl+w"
      ]
    },
    "Coderabbit": {
      "description": "The pinned `CodeRabbit` command line and its artifact for each host platform.",
      "type": "object",
      "properties": {
        "platforms": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/Artifact"
          }
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "ContrastPair": {
      "description": "Two palette names that a theme draws text with, the text's color on the background's.",
      "type": "object",
      "properties": {
        "background": {
          "type": "string"
        },
        "foreground": {
          "type": "string"
        },
        "used": {
          "description": "Where a theme draws this pair.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "foreground",
        "background",
        "used"
      ]
    },
    "Domyjob": {
      "type": "object",
      "properties": {
        "chat": {
          "$ref": "#/$defs/Chat"
        }
      },
      "additionalProperties": false,
      "required": [
        "chat"
      ]
    },
    "EditMode": {
      "description": "The line editor mode of every shell.",
      "type": "string",
      "enum": [
        "vi",
        "emacs"
      ]
    },
    "FallbackEditor": {
      "description": "The editor of a host that has none of the preferred editors, for each OS family.",
      "type": "object",
      "properties": {
        "unix": {
          "type": "string"
        },
        "windows": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "unix",
        "windows"
      ]
    },
    "Herdr": {
      "type": "object",
      "properties": {
        "channel": {
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "expected_build_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "manifest_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "retain": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "HerdrAgent": {
      "type": "object",
      "properties": {
        "public_keys": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "Hex": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
    },
    "KeyAction": {
      "description": "A line editing action that every shell's line editor provides.",
      "type": "string",
      "enum": [
        "word_left",
        "word_right",
        "kill_word",
        "kill_to_start",
        "kill_to_end",
        "line_start",
        "line_end"
      ]
    },
    "Linux": {
      "type": "object",
      "properties": {
        "desktop": {
          "anyOf": [
            {
              "$ref": "#/$defs/LinuxDesktop"
            },
            {
              "type": "null"
            }
          ]
        },
        "mise": {
          "anyOf": [
            {
              "$ref": "#/$defs/Mise"
            },
            {
              "type": "null"
            }
          ]
        },
        "nix": {
          "anyOf": [
            {
              "$ref": "#/$defs/Nix"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool_versions": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "tools": {
          "anyOf": [
            {
              "$ref": "#/$defs/Tools"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "LinuxDesktop": {
      "type": "object",
      "properties": {
        "keyboard": {
          "anyOf": [
            {
              "$ref": "#/$defs/LinuxKeyboard"
            },
            {
              "type": "null"
            }
          ]
        },
        "kitty_channel": {
          "type": [
            "string",
            "null"
          ]
        },
        "nerd_fonts_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "opacity": {
          "type": [
            "string",
            "null"
          ]
        },
        "zed_channel": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "LinuxKeyboard": {
      "type": "object",
      "properties": {
        "delay": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "repeat_interval": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "Mac": {
      "type": "object",
      "properties": {
        "brew": {
          "anyOf": [
            {
              "$ref": "#/$defs/Brew"
            },
            {
              "type": "null"
            }
          ]
        },
        "desktop": {
          "anyOf": [
            {
              "$ref": "#/$defs/MacDesktop"
            },
            {
              "type": "null"
            }
          ]
        },
        "macos": {
          "anyOf": [
            {
              "$ref": "#/$defs/Macos"
            },
            {
              "type": "null"
            }
          ]
        },
        "mise": {
          "anyOf": [
            {
              "$ref": "#/$defs/Mise"
            },
            {
              "type": "null"
            }
          ]
        },
        "racket": {
          "anyOf": [
            {
              "$ref": "#/$defs/Racket"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool_versions": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "tools": {
          "anyOf": [
            {
              "$ref": "#/$defs/Tools"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "MacDesktop": {
      "type": "object",
      "properties": {
        "blur": {
          "type": [
            "string",
            "null"
          ]
        },
        "font_family": {
          "type": [
            "string",
            "null"
          ]
        },
        "font_size": {
          "type": [
            "string",
            "null"
          ]
        },
        "opacity": {
          "type": [
            "string",
            "null"
          ]
        },
        "zed_channel": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "MacKeyboard": {
      "type": "object",
      "properties": {
        "initial_key_repeat": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "key_repeat": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "press_and_hold": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Macos": {
      "type": "object",
      "properties": {
        "keyboard": {
          "anyOf": [
            {
              "$ref": "#/$defs/MacKeyboard"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Mise": {
      "type": "object",
      "properties": {
        "jobs": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "MiseRelease": {
      "description": "A mise release and the SHA-256 of its asset for each platform, such as `linux-x64` or `windows-x64`.",
      "type": "object",
      "properties": {
        "sha256": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Modern": {
      "description": "The modern tool table: each preferred tool, the bootstrap scripts that keep legacy tools, and the candidates it leaves out.",
      "type": "object",
      "properties": {
        "exceptions": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ModernException"
          }
        },
        "rejected": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ModernRejected"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModernTool"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "tools"
      ]
    },
    "ModernException": {
      "description": "A script that runs before mise provisions the preferred tools, so it keeps the legacy ones.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "reason"
      ]
    },
    "ModernRejected": {
      "description": "A candidate the table leaves out, with the condition that would admit it.",
      "type": "object",
      "properties": {
        "legacy": {
          "type": "string"
        },
        "preferred": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "revisit": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "legacy",
        "preferred",
        "reason",
        "revisit"
      ]
    },
    "ModernTool": {
      "description": "One preferred tool and the legacy commands it replaces.",
      "type": "object",
      "properties": {
        "keep": {
          "description": "When the legacy tool stays correct.",
          "type": "string"
        },
        "legacy": {
          "description": "The legacy commands the hooks refuse.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next": {
          "description": "The next action, where `{args}` stands for the legacy command's arguments, and `grep` or `find` asks for a flag translation.",
          "type": "string"
        },
        "preferred": {
          "description": "The command the next action names.",
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "stream": {
          "description": "Whether the legacy command stays admitted when it reads only standard input, such as `wc -l` in a pipeline.",
          "type": "boolean",
          "default": false
        },
        "tool": {
          "description": "The mise tool that installs the preferred command on every profile.",
          "type": "string"
        },
        "version": {
          "description": "The pinned version.",
          "type": "string"
        },
        "when": {
          "description": "The flags that mark an invocation as legacy when the tool replaces only some uses, such as `-l` for `wc`.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "legacy",
        "preferred",
        "tool",
        "version",
        "reason",
        "keep",
        "next"
      ]
    },
    "Nix": {
      "description": "The packages the Nix profile installs, each with the mise tool that replaces it where Nix stays absent, or an empty string for none.",
      "type": "object",
      "properties": {
        "packages": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "Ocaml": {
      "type": "object",
      "properties": {
        "compiler": {
          "type": [
            "string",
            "null"
          ]
        },
        "platform_tools": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "switch": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Ocomment": {
      "type": "object",
      "properties": {
        "destination": {
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "repo_url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Palette": {
      "description": "The Tokyo Night colors of every themed tool, each a `#rrggbb` literal.",
      "type": "object",
      "properties": {
        "bg": {
          "anyOf": [
            {
