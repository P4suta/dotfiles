{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data",
  "description": "Every key a data file may hold.",
  "type": "object",
  "properties": {
    "coderabbit": {
      "anyOf": [
        {
          "$ref": "#/$defs/Coderabbit"
        },
        {
          "type": "null"
        }
      ]
    },
    "contrast": {
      "description": "The foreground and background palette names that some theme draws text with, each of which keeps a text contrast of 4.5:1.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/ContrastPair"
      }
    },
    "domyjob": {
      "anyOf": [
        {
          "$ref": "#/$defs/Domyjob"
        },
        {
          "type": "null"
        }
      ]
    },
    "herdr_agent": {
      "anyOf": [
        {
          "$ref": "#/$defs/HerdrAgent"
        },
        {
          "type": "null"
        }
      ]
    },
    "mise": {
      "description": "The mise release that every host installs before any other step.",
      "anyOf": [
        {
          "$ref": "#/$defs/MiseRelease"
        },
        {
          "type": "null"
        }
      ]
    },
    "modern": {
      "description": "The modern command-line tools that replace legacy ones for agents, pinned on every profile.",
      "anyOf": [
        {
          "$ref": "#/$defs/Modern"
        },
        {
          "type": "null"
        }
      ]
    },
    "ocaml": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ocaml"
        },
        {
          "type": "null"
        }
      ]
    },
    "palette": {
      "description": "The one palette every themed target renders its colors from.",
      "anyOf": [
        {
          "$ref": "#/$defs/Palette"
        },
        {
          "type": "null"
        }
      ]
    },
    "platforms": {
      "anyOf": [
        {
          "$ref": "#/$defs/Platforms"
        },
        {
          "type": "null"
        }
      ]
    },
    "profiles": {
      "description": "Named sets of profiles.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "retired": {
      "description": "Retired targets that the profiles of the named set remove.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "scripts": {
      "description": "Setup launchers that only the profiles of the named set run, which `just gen` writes from the setup steps.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "targets": {
      "description": "Targets that only the profiles of the named set receive.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Artifact": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Brew": {
      "type": "object",
      "properties": {
        "casks": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "formulae": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "Chat": {
      "type": "object",
      "properties": {
        "peers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "peers"
      ]
    },
    "Coderabbit": {
      "description": "The pinned `CodeRabbit` command line and its artifact for each host platform.",
      "type": "object",
      "properties": {
        "platforms": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/Artifact"
          }
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "ContrastPair": {
      "description": "Two palette names that a theme draws text with, the text's color on the background's.",
      "type": "object",
      "properties": {
        "background": {
          "type": "string"
        },
        "foreground": {
          "type": "string"
        },
        "used": {
          "description": "Where a theme draws this pair.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "foreground",
        "background",
        "used"
      ]
    },
    "Domyjob": {
      "type": "object",
      "properties": {
        "chat": {
          "$ref": "#/$defs/Chat"
        }
      },
      "additionalProperties": false,
      "required": [
        "chat"
      ]
    },
    "Herdr": {
      "type": "object",
      "properties": {
        "channel": {
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
