        },
        "expected_build_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "manifest_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "retain": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "HerdrAgent": {
      "type": "object",
      "properties": {
        "public_keys": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "Hex": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
    },
    "Linux": {
      "type": "object",
      "properties": {
        "desktop": {
