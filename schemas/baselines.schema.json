{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baselines",
  "type": "object",
  "properties": {
    "metric": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Metric"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Metric": {
      "description": "One deterministic metric and its recorded value.\nWall time appears only as an advisory note, so no entry can gate on it.",
      "oneOf": [
        {
          "description": "The public functions of the decision core that a Kani harness proves, which merging two harnesses of one decision leaves unchanged.",
          "type": "object",
          "properties": {
            "exact": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "metric": {
              "type": "string",
              "const": "proved-subjects"
            }
          },
          "additionalProperties": false,
          "required": [
            "metric",
            "exact"
          ]
        },
        {
          "description": "The rejecting probes of the decision core.",
          "type": "object",
          "properties": {
            "exact": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "metric": {
              "type": "string",
              "const": "probes"
            }
          },
          "additionalProperties": false,
          "required": [
            "metric",
            "exact"
          ]
        },
        {
          "description": "The unsafe blocks, functions, and implementations of the workspace.",
          "type": "object",
          "properties": {
            "exact": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "metric": {
              "type": "string",
              "const": "unsafe-sites"
            }
          },
          "additionalProperties": false,
          "required": [
            "metric",
            "exact"
          ]
        },
        {
          "description": "The mutants of the decision core that its tests let survive, which `just proofs` measures.",
          "type": "object",
          "properties": {
            "exact": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "metric": {
              "type": "string",
              "const": "mutants-missed"
            }
          },
          "additionalProperties": false,
          "required": [
            "metric",
            "exact"
          ]
        },
        {
          "description": "The mutants of the decision core that timed out without a non-terminating entry, which `just proofs` measures.",
          "type": "object",
          "properties": {
            "exact": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "metric": {
              "type": "string",
              "const": "mutants-timed-out"
            }
          },
          "additionalProperties": false,
          "required": [
            "metric",
            "exact"
          ]
        },
        {
          "description": "A wall time measured on one host, which never gates.",
          "type": "object",
          "properties": {
            "advisory": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "metric": {
              "type": "string",
              "const": "wall-millis"
            }
          },
          "additionalProperties": false,
          "required": [
            "metric",
            "advisory"
          ]
        },
        {
          "description": "The lowest text contrast in thousandths and the palette pair that reaches it.",
          "type": "object",
          "properties": {
            "exact": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "metric": {
              "type": "string",
              "const": "minimum-contrast"
            },
            "pair": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "metric",
            "exact",
            "pair"
          ]
        }
      ]
    }
  }
}
