{{ if .platforms.windows.sshd.enabled -}}
$ErrorActionPreference = 'Stop'
& {{ includeTemplate "partials/ps_quote" (joinPath .chezmoi.homeDir ".local/bin/dotctl.exe") }} setup sshd `
    --port {{ .platforms.windows.sshd.port }} `
    --default-shell {{ includeTemplate "partials/ps_quote" .platforms.windows.sshd.default_shell }} `
    --password-auth {{ if .platforms.windows.sshd.password_auth }}true{{ else }}false{{ end }} `
    --firewall-profile {{ includeTemplate "partials/ps_quote" .platforms.windows.sshd.firewall_profile }} `
    --authorized-key {{ if and .platforms.windows.sshd.authorize_signing_key .signing.enabled }}{{ includeTemplate "partials/ps_quote" (includeTemplate "partials/signing_pubkey" . | trim) }}{{ else }}''{{ end }}
exit $LASTEXITCODE
{{ end -}}
