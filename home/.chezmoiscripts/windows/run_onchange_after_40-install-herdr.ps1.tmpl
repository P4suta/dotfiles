{{ if .platforms.windows.herdr.enabled -}}
# revision: {{ .platforms.windows.herdr.revision }}
$ErrorActionPreference = 'Stop'
& {{ includeTemplate "partials/ps_quote" (joinPath .chezmoi.homeDir ".local/bin/dotctl.exe") }} setup herdr `
    --manifest-url {{ includeTemplate "partials/ps_quote" .platforms.windows.herdr.manifest_url }} `
    --channel {{ includeTemplate "partials/ps_quote" .platforms.windows.herdr.channel }} `
    --expected-build-id {{ includeTemplate "partials/ps_quote" .platforms.windows.herdr.expected_build_id }} `
    --retain {{ .platforms.windows.herdr.retain }}
exit $LASTEXITCODE
{{ end -}}
