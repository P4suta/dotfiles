{{- /* chezmoi:modify-template */ -}}
{{- /*
  Codex reads its hooks from this file, so each profile sets the verification hooks and keeps unrelated handlers.
  A session starts with the verification report, which lists the repository's code shapes that nothing verifies with their next actions.
  On Windows it first runs the process-start probe, as the Claude Code session does.
  The stop hook refuses to end a turn while a file it changed holds such a shape.
  The pre-tool hook blocks a malformed or file-writing shell command before Codex runs it, through the decision core every managed client shares.
*/ -}}
{{- $current := dict -}}
{{- if trim .chezmoi.stdin -}}{{- $current = fromJson .chezmoi.stdin -}}{{- end -}}
{{- $_ := set $current "hooks" (includeTemplate "partials/without_skill_ops_hooks" (dig "hooks" (dict) $current) | fromJson) -}}
{{- $tool := ".local/bin/dotfiles" -}}
{{- if eq .profile "windows" }}{{ $tool = ".local/bin/dotfiles.exe" }}{{ end -}}
{{- $runtime := joinPath .chezmoi.homeDir $tool -}}
{{- $hooks := dig "hooks" (dict) $current -}}
{{- $pre := includeTemplate "partials/without_runtime_handlers" (dict "groups" (dig "PreToolUse" (list) $hooks) "suffixes" (list " claude-bash" " issue-guard")) | fromJson -}}
{{- $shell := includeTemplate "partials/codex_runtime_hook" (dict "profile" .profile "tool" $runtime "arguments" "claude-bash" "trace" true) | fromJson -}}
{{- $own_pre := dict "matcher" "Bash|shell|exec_command" "hooks" (list $shell) -}}
{{- $_ := set $hooks "PreToolUse" (concat $pre (list $own_pre)) -}}
{{- $edit := includeTemplate "partials/codex_runtime_hook" (dict "profile" .profile "tool" $runtime "arguments" "issue-guard" "trace" true) | fromJson -}}
{{- $issue := dict "matcher" "apply_patch|Edit|Write|MultiEdit|edit|write" "hooks" (list $edit) -}}
{{- $_ := set $hooks "PreToolUse" (concat (dig "PreToolUse" (list) $hooks) (list $issue)) -}}
{{- range $event, $point := dict "SessionStart" "start" "Stop" "stop" -}}
{{-   $groups := includeTemplate "partials/without_runtime_handlers" (dict "groups" (dig $event (list) $hooks) "suffixes" (list " health --session" (printf " assure %s" $point))) | fromJson -}}
{{-   $own := list -}}
{{-   if and (eq $event "SessionStart") (eq $.profile "windows") -}}
{{-     $own = append $own (includeTemplate "partials/codex_runtime_hook" (dict "profile" $.profile "tool" $runtime "arguments" "health --session" "trace" true) | fromJson) -}}
{{-   end -}}
{{-   $own = append $own (includeTemplate "partials/codex_runtime_hook" (dict "profile" $.profile "tool" $runtime "arguments" (printf "assure %s" $point) "trace" true) | fromJson) -}}
{{-   $_ := set $hooks $event (concat $groups (list (dict "hooks" $own))) -}}
{{- end -}}
{{- if eq (includeTemplate "partials/skill_ops_experimental" .) "true" -}}
{{- $observe := dict "type" "command" "command" "skill-ops observe --client codex" "timeout" 10 -}}
{{- $_ := set $hooks "PostToolUse" (concat (dig "PostToolUse" (list) $hooks) (list (dict "matcher" "Read|read|Skill|skill|Bash|bash|exec_command" "hooks" (list $observe)))) -}}
{{- $hold := dict "type" "command" "command" "skill-ops stop" "timeout" 10 -}}
{{- $_ := set $hooks "Stop" (concat (dig "Stop" (list) $hooks) (list (dict "hooks" (list $hold)))) -}}
{{- end -}}
{{ mergeOverwrite $current (dict "hooks" $hooks) | toPrettyJson "  " | trim }}
