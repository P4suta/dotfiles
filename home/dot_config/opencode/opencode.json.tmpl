{{- /*
  One OpenCode configuration for every profile.
  Every host declares the same servers, and only executables and paths differ.
  Context7 loads only on a local workstation with the 1Password app, which a WSL session can't reach.
  The gcloud server loads only where the gcp skill installed it, which only the Mac does.
  The Mac keeps its own permission rules until the owner decides how to gate agents.
*/ -}}
{{- $isLocal := not (or (env "SSH_CONNECTION") (env "SSH_CLIENT") (env "SSH_TTY")) -}}
{{- $hasOnePassword := false -}}
{{- if eq .profile "mac" -}}
{{-   $hasOnePassword = and (eq .chezmoi.os "darwin") $isLocal (stat (default "/Applications/1Password.app" (env "DOTFILES_ONEPASSWORD_APP"))) -}}
{{- else if eq .profile "linux" -}}
{{-   $hasOnePassword = and (eq .chezmoi.os "linux") $isLocal (ne (lookPath "1password") "") -}}
{{- else if eq .profile "windows" -}}
{{-   $hasOnePassword = true -}}
{{- end -}}
{{- $gcloudMcp := joinPath .chezmoi.homeDir ".local/share/gcloud-mcp/node_modules/@google-cloud/gcloud-mcp/dist/bundle.js" -}}
{{- $node := joinPath .chezmoi.homeDir ".local/share/mise/installs/node/latest/bin" -}}
{{- $npx := list "npx" -}}
{{- if eq .profile "windows" }}{{ $npx = list "cmd" "/c" "npx" }}{{ end -}}
{{- $domyjobMcp := includeTemplate "partials/domyjob_mcp" . -}}
{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "formatter": true,
  "lsp": true,
  "permission": {
{{- if eq .profile "mac" }}
    "*": "allow",
{{- end }}
    "external_directory": "deny",
    "read": {
      "*": "allow",
      ".github/instructions/memory.instruction.md": "deny",
      "*/.github/instructions/memory.instruction.md": "deny"
    },
    "edit": {
      "*": "allow",
      ".github/instructions/memory.instruction.md": "deny",
      "*/.github/instructions/memory.instruction.md": "deny"
    },
    "bash": {
      "*": "allow",
{{- if eq .profile "mac" }}
      "sudo *": "deny",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -fr /": "deny",
      "rm -fr /*": "deny",
      "rm -rf ~": "deny",
      "rm -rf ~/*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "curl * | sh": "deny",
      "curl * | bash": "deny",
      "wget * | sh": "deny",
      "wget * | bash": "deny",
{{- end }}
      "*memory.instruction.md*": "deny"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": {{ concat $npx (list "-y" "@playwright/mcp") | toJson }},
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GH_MCP_TOKEN}",
        "X-MCP-Toolsets": "repos,issues,pull_requests,notifications",
        "X-MCP-Readonly": "true"
      },
      "oauth": false,
      "enabled": true
    }{{ if and (eq .profile "mac") (stat $gcloudMcp) }},
    "gcloud": {
      "type": "local",
      "command": [{{ joinPath $node "node" | toJson }}, {{ $gcloudMcp | toJson }}],
      "environment": {
        "CLOUDSDK_CORE_DISABLE_PROMPTS": "1",
        "PATH": {{ printf "/opt/homebrew/share/google-cloud-sdk/bin:%s:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin" $node | toJson }}
      },
      "enabled": true,
      "timeout": 30000
    }{{ end }}{{ if $domyjobMcp }},
    "domyjob": {{ $domyjobMcp }}{{ end }}
  }{{ if $hasOnePassword }},
  "plugin": ["@upstash/context7-opencode"]{{ end }}
}
