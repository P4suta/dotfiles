{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "{{ .palette.bg }}",
    "bgPanel": "{{ .palette.bg_panel }}",
    "bgElement": "{{ .palette.bg_highlight }}",
    "fg": "{{ .palette.fg }}",
    "fgMuted": "{{ .palette.comment }}",
    "fgGutter": "{{ .palette.surface }}",
    "blue": "{{ .palette.blue }}",
    "cyan": "{{ .palette.cyan }}",
    "green": "{{ .palette.green }}",
    "green1": "{{ .palette.teal }}",
    "magenta": "{{ .palette.magenta }}",
    "purple": "{{ .palette.purple }}",
    "orange": "{{ .palette.orange }}",
    "yellow": "{{ .palette.yellow }}",
    "red": "{{ .palette.red }}",
    "diffAdd": "{{ .palette.diff_add }}",
    "diffDel": "{{ .palette.diff_del }}",
    "diffAddGutter": "{{ .palette.diff_add_gutter }}",
    "diffDelGutter": "{{ .palette.diff_del_gutter }}"
  },
  "theme": {
    "primary": "blue",
    "secondary": "magenta",
    "accent": "cyan",
    "error": "red",
    "warning": "yellow",
    "success": "green",
    "info": "cyan",
    "text": "fg",
    "textMuted": "fgMuted",
    "background": "bg",
    "backgroundPanel": "bgPanel",
    "backgroundElement": "bgElement",
    "border": "fgGutter",
    "borderActive": "fgMuted",
    "borderSubtle": "fgGutter",
    "diffAdded": "green",
    "diffRemoved": "red",
    "diffContext": "fgMuted",
    "diffHunkHeader": "fgMuted",
    "diffHighlightAdded": "green1",
    "diffHighlightRemoved": "red",
    "diffAddedBg": "diffAdd",
    "diffRemovedBg": "diffDel",
    "diffContextBg": "bgPanel",
    "diffLineNumber": "fgMuted",
    "diffAddedLineNumberBg": "diffAddGutter",
    "diffRemovedLineNumberBg": "diffDelGutter",
    "markdownText": "fg",
    "markdownHeading": "blue",
    "markdownLink": "magenta",
    "markdownLinkText": "blue",
    "markdownCode": "green",
    "markdownBlockQuote": "fgMuted",
    "markdownEmph": "orange",
    "markdownStrong": "magenta",
    "markdownHorizontalRule": "fgGutter",
    "markdownListItem": "blue",
    "markdownListEnumeration": "cyan",
    "markdownImage": "magenta",
    "markdownImageText": "blue",
    "markdownCodeBlock": "fg",
    "syntaxComment": "fgMuted",
    "syntaxKeyword": "magenta",
    "syntaxFunction": "blue",
    "syntaxVariable": "fg",
    "syntaxString": "green",
    "syntaxNumber": "orange",
    "syntaxType": "cyan",
    "syntaxOperator": "cyan",
    "syntaxPunctuation": "fg"
  }
}
