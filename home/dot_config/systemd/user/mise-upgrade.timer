[Unit]
Description=Run mise upgrade after WSL boot (and weekly if it stays up)

[Timer]
# WSL stays stopped for long periods, so a startup delay fits better than a calendar time.
# The timer fires five minutes after boot and again every week while WSL keeps running.
OnStartupSec=5min
OnUnitActiveSec=1w
Persistent=false

[Install]
WantedBy=timers.target
