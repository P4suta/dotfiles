{{- $context := merge (dict) . (index .platforms .profile) -}}
{{- if eq .profile "mac" -}}
{{ includeTemplate "profiles/mac/dot_local/bin/executable_git.tmpl" $context }}
{{- else if eq .profile "linux" -}}
{{ includeTemplate "profiles/linux/dot_local/bin/executable_git.tmpl" $context }}
{{- else if eq .profile "wsl" -}}
{{ includeTemplate "profiles/wsl/dot_local/bin/executable_git.tmpl" $context }}
{{- else -}}{{ fail "Target is unavailable for this profile" }}{{- end -}}
