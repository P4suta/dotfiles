case $- in
  *i*) ;;
  *) return ;;
esac

# shellcheck source=/dev/null
if [[ -r "${HOME}/.config/shell/ssh-agent.sh" ]]; then
  . "${HOME}/.config/shell/ssh-agent.sh"
fi

if [[ -o interactive && -t 0 && -t 1 ]] \
  && [[ -z "${DOTFILES_NO_NU:-}${DOTFILES_BASH_ONLY:-}" ]] \
  && command -v nu >/dev/null 2>&1; then
  exec nu
fi

{{ includeTemplate "partials/interactive_posix" (dict "syntax" "zsh" "data" .) }}

# The integrations setup step caches each tool's initialization under ~/.cache/zsh, as it does for PowerShell, so starting a shell runs no other program.
# The mise cache leaves its environment hook to the first prompt.
zsh_cache="${HOME}/.cache/zsh"
if [[ -r "${zsh_cache}/mise.zsh" ]]; then
  . "${zsh_cache}/mise.zsh"
fi

export PATH="${HOME}/.local/bin:${PATH}"

if [[ -r "${HOME}/.opam/opam-init/init.zsh" ]]; then
  . "${HOME}/.opam/opam-init/init.zsh" >/dev/null 2>&1 || true
fi

# Atuin's initialization asks `atuin uuid` for a session unless one exists for this shell level, so the shell names its own.
if [[ -z "${ATUIN_SESSION:-}" || "${ATUIN_SHLVL:-}" != "${SHLVL}" ]]; then
  printf -v ATUIN_SESSION '%04x%04x%04x%04x%04x%04x%04x%04x' \
    "${RANDOM}" "${RANDOM}" "${RANDOM}" "${RANDOM}" "${RANDOM}" "${RANDOM}" "${RANDOM}" "${RANDOM}"
  export ATUIN_SESSION
  export ATUIN_SHLVL="${SHLVL}"
fi

for zsh_init in starship zoxide atuin fzf ls-colors; do
  if [[ -r "${zsh_cache}/${zsh_init}.zsh" ]]; then
    . "${zsh_cache}/${zsh_init}.zsh"
  fi
done
unset zsh_cache zsh_init
