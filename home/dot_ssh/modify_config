{{- /* chezmoi:modify-template */ -}}
{{- /* The agent file ends inside `Host *`, so the generated host logins come first and stay top level. */ -}}
{{- $hosts := "Include ~/.local/state/hosts/ssh_config" -}}
{{- $include := "Include ~/.config/dotfiles/ssh-agent.conf" -}}
{{- $lines := list -}}
{{- $inserted := false -}}
{{- range splitList "\n" (trimSuffix "\n" .chezmoi.stdin) -}}
{{- if and (ne (trim .) $hosts) (ne (trim .) $include) -}}
{{- if and (not $inserted) (ne (trim .) "") (not (hasPrefix "#" (trim .))) (not (regexMatch "(?i)^\\s*Include\\s+\"?~/\\.orbstack/ssh/config\"?\\s*$" .)) -}}
{{- $lines = append $lines $hosts -}}
{{- $lines = append $lines $include -}}
{{- $inserted = true -}}
{{- end -}}
{{- $lines = append $lines . -}}
{{- end -}}
{{- end -}}
{{- if not $inserted -}}{{- $lines = append $lines $hosts -}}{{- $lines = append $lines $include -}}{{- end -}}
{{ join "\n" $lines }}
