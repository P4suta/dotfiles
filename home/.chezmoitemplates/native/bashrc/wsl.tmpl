case $- in
    *i*) ;;
      *) return;;
esac

{{ includeTemplate "partials/interactive_posix" (dict "syntax" "bash" "data" .) }}

if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    # shellcheck source=/dev/null
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    # shellcheck source=/dev/null
    . /etc/bash_completion
  fi
fi

export PATH="$HOME/.local/bin:$PATH"

# Windows op.exe reaches the 1Password app.
alias op="op.exe"

# Windows SSH tools reach the 1Password SSH agent.
alias ssh="ssh.exe"
alias ssh-add="ssh-add.exe"
alias ssh-keygen="ssh-keygen.exe"
alias scp="scp.exe"
alias sftp="sftp.exe"
export GIT_SSH="/mnt/c/WINDOWS/System32/OpenSSH/ssh.exe"

# WezTerm starts here in a translated Windows directory.
case "$PWD" in /mnt/*) cd ~ || return ;; esac

if [ -x "$HOME/.local/bin/mise" ]; then
  eval "$("$HOME/.local/bin/mise" activate bash)"
fi

command -v starship >/dev/null && eval "$(starship init bash)"
command -v zoxide   >/dev/null && eval "$(zoxide init bash)"
command -v direnv   >/dev/null && eval "$(direnv hook bash)"
command -v atuin    >/dev/null && eval "$(atuin init bash --disable-up-arrow)"
command -v fzf      >/dev/null && eval "$(fzf --bash)"

if command -v vivid >/dev/null; then
  LS_COLORS="$(vivid generate tokyonight-night)"
  export LS_COLORS
fi

if command -v jj >/dev/null; then
  # shellcheck source=/dev/null
  source <(jj util completion bash) 2>/dev/null
fi

# WSL integration.
export BROWSER="/mnt/c/Windows/System32/cmd.exe /c start"
command -v wslview >/dev/null && alias open='wslview'
