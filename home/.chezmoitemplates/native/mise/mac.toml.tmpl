{{- $pins := includeTemplate "partials/modern-pins" . | fromJson -}}
[tools]
{{- range (includeTemplate "partials/mise_tools" (dict "platform" .platforms.mac "shared" .shared_tools "profile" .profile "role" .role) | fromJson) }}
{{- $tool := index . 0 }}
{{- if not (or (eq $tool "ghc") (hasKey $pins $tool)) }}
{{ $tool | quote }} = {{ index . 1 | quote }}
{{- end }}
{{- end }}
{{- range $tool, $version := $pins }}
{{ $tool | quote }} = {{ $version | quote }}
{{- end }}

# GHCup's version listing bootstraps its installer.
# A ref installs the exact release directly.
ghc = {{ printf "ref:%s" .platforms.mac.tool_versions.ghc | quote }}
"github:haskell/haskell-language-server" = { version = {{ index .platforms.mac.tool_versions "haskell-language-server" | quote }}, bin = ["haskell-language-server-wrapper", {{ printf "haskell-language-server-%s" .platforms.mac.tool_versions.ghc | quote }}] }

# The CodeRabbit guard runs managed reviews on the Mac and finds this runtime through `mise where`.
[tools."http:coderabbit"]
version = {{ .coderabbit.version | quote }}
rename_exe = "coderabbit-vendor"

[tools."http:coderabbit".platforms]
{{- range $platform, $artifact := .coderabbit.platforms }}
{{ $platform }} = { url = "https://cli.coderabbit.ai/releases/{{ $.coderabbit.version }}/{{ $artifact.artifact }}", checksum = "sha256:{{ $artifact.sha256 }}"{{ if hasPrefix "windows-" $platform }}, rename_exe = "coderabbit-vendor.exe"{{ end }} }
{{- end }}

[tool_alias]
ghc = "asdf:mise-plugins/mise-ghcup"

{{ includeTemplate "partials/mise_settings" . }}
