{{- $pins := includeTemplate "partials/modern-pins" . | fromJson -}}
[tools]
{{- range (concat .platforms.mac.tools.common (index .platforms.mac.tools .role) | uniq) }}
{{- if not (or (eq . "ghc") (hasKey $pins .)) }}
{{ . | quote }} = {{ if hasKey $.platforms.mac.tool_versions . }}{{ index $.platforms.mac.tool_versions . | quote }}{{ else }}"latest"{{ end }}
{{- end }}
{{- end }}
{{- range $tool, $version := $pins }}
{{ $tool | quote }} = {{ $version | quote }}
{{- end }}

# GHCup's version listing bootstraps its installer.
# A ref installs the exact release directly.
ghc = {{ printf "ref:%s" .platforms.mac.tool_versions.ghc | quote }}
"github:haskell/haskell-language-server" = { version = {{ index .platforms.mac.tool_versions "haskell-language-server" | quote }}, bin = ["haskell-language-server-wrapper", {{ printf "haskell-language-server-%s" .platforms.mac.tool_versions.ghc | quote }}] }

[tool_alias]
ghc = "asdf:mise-plugins/mise-ghcup"

[settings]
experimental = true
# A project's configuration loads only after `mise trust` records its exact contents.
paranoid = true
jobs = {{ .platforms.mac.mise.jobs }}
# domyjob runs the owner's own projects in this work area, and each new workspace path would otherwise have its mise.toml refused.
trusted_config_paths = [{{ joinPath .chezmoi.homeDir ".local/state/domyjob/v3/work" | quote }}]

[settings.hook_env]
chpwd_only = true

[settings.github]
gh_cli_tokens = true
credential_command = {{ includeTemplate "partials/mise-github-credential" . }}
