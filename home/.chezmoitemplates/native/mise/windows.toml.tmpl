{{- $pins := includeTemplate "partials/modern-pins" . | fromJson -}}
[tools]
{{- range (concat .platforms.windows.tools.common (index .platforms.windows.tools .role) | uniq) }}
{{- if not (hasKey $pins .) }}
{{ . | quote }} = {{ if eq . "rust" }}"stable"{{ else }}"latest"{{ end }}
{{- end }}
{{- end }}
{{- range $tool, $version := $pins }}
{{ $tool | quote }} = {{ $version | quote }}
{{- end }}

[settings]
experimental = true
# A project's configuration loads only after `mise trust` records its exact contents.
paranoid = true
# domyjob runs the owner's own projects in this work area, and each new workspace path would otherwise have its mise.toml refused.
trusted_config_paths = [{{ joinPath (env "LOCALAPPDATA") "domyjob/state/v3/work" | quote }}]
cargo.binstall = true

[settings.github]
credential_command = 'gh auth token --hostname %MISE_CREDENTIAL_HOST%'
