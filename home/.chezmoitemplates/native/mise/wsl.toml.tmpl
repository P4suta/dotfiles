{{- $pins := includeTemplate "partials/modern-pins" . | fromJson -}}
[tools]
{{- range (concat .platforms.wsl.tools.common (index .platforms.wsl.tools .role) | uniq) }}
{{- if not (hasKey $pins .) }}
{{ . | quote }} = "latest"
{{- end }}
{{- end }}
{{- range $tool, $version := $pins }}
{{ $tool | quote }} = {{ $version | quote }}
{{- end }}

