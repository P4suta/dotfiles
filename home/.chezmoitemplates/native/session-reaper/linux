# Read by the systemd unit as an EnvironmentFile.
# Change a value here and run `chezmoi apply`, which overwrites direct edits.

# Mode: report or reap.
# report only logs and notifies.
# reap ends tier A processes.
# Tier B, running orphans, stays report-only in every mode.
# Set `report` and apply to roll back.
SESSION_REAPER_MODE=reap

# Tier A: least age in seconds of a stopped orphan.
SESSION_REAPER_STOPPED_MIN_AGE=3600

# Tier A: seconds a process must stay a stopped orphan, across a prior run, before it ends.
SESSION_REAPER_GRACE_SECONDS=1800

# Tier B: least age in seconds of a reported running orphan without a tty.
SESSION_REAPER_RUNNING_MIN_AGE=259200

# Anchored ERE of process names that tier A never touches.
SESSION_REAPER_ALLOW_REGEX=^(tmux.*|screen.*|sshd|systemd|systemd-.*|dbus-.*|pipewire.*|wireplumber|pulseaudio|gvfsd.*|ssh-agent|gpg-agent|gnome-keyring-d|code-.*|session-reaper)$

# Desktop notifications: 1 on, 0 off.
SESSION_REAPER_NOTIFY=1
