let home = $nu.home-dir
let onepassword_agent = (
  $home | path join "Library" "Group Containers" "2BUA8C4S2C.com.1password" "t" "agent.sock"
)

# A login zsh gets /etc/paths and /etc/paths.d from path_helper, but a terminal-started Nushell inherits launchd's shorter PATH, which lacks /usr/local/bin.
def dotfiles-system-path [] {
  ["/etc/paths"]
  | append (try { ls /etc/paths.d | where type == file | get name | sort } catch { [] })
  | each {|file| try { open --raw $file | lines } catch { [] } }
  | flatten
  | str trim
  | where {|entry| $entry != "" }
}

def --env dotfiles-prepend-path [] {
  let home = $nu.home-dir
  $env.PATH = (
    $env.PATH
    | prepend (dotfiles-system-path)
    | prepend [
      ($home | path join ".local" "bin")
      ($home | path join ".local" "share" "mise" "shims")
      ($home | path join ".opam" "{{ .ocaml.switch }}" "bin")
      "/opt/homebrew/bin"
      "/opt/homebrew/sbin"
    ]
    | uniq
  )
}
dotfiles-prepend-path

$env.EDITOR = {{ if lookPath "zed" }}"zed --wait"{{ else if lookPath "code" }}"code --wait"{{ else }}"nano"{{ end }}
$env.VISUAL = $env.EDITOR
$env.PAGER = "ov"
$env.MANPAGER = "sh -c 'col -bx | bat --language=man --plain'"
$env.FZF_DEFAULT_OPTS_FILE = ($home | path join ".config" "fzf" "fzfrc")
$env.DOTFILES_NU_SESSION = "1"

let is_remote_ssh = (($env.SSH_CONNECTION? | default "") | is-not-empty)
let explicit_agent = ($env.DOTFILES_SSH_AUTH_SOCK? | default "")
let herdr_agent_bin = ($home | path join ".local" "bin" "herdr-agent")
let herdr_agent = if (
  (not $is_remote_ssh)
  and (($env.HERDR_ENV? | default "") | is-not-empty)
  and ($herdr_agent_bin | path exists)
) {
  let ready = (do { ^$herdr_agent_bin ready } | complete)
  if $ready.exit_code == 0 { $ready.stdout | str trim } else { "" }
} else { "" }
if ($explicit_agent | is-not-empty) and ($explicit_agent | path exists) {
  $env.SSH_AUTH_SOCK = $explicit_agent
} else if ($herdr_agent | is-not-empty) {
  $env.SSH_AUTH_SOCK = $herdr_agent
  $env.GIT_SSH_COMMAND = $"ssh -o IdentityAgent=($herdr_agent)"
} else if (not $is_remote_ssh) and ($onepassword_agent | path exists) {
  $env.SSH_AUTH_SOCK = $onepassword_agent
}

$env.OPENCODE_EXPERIMENTAL_PLAN_MODE = "true"
