$ErrorActionPreference = 'Stop'
& {{ includeTemplate "ps_quote" (joinPath .chezmoi.homeDir ".local/bin/dotctl.exe") }} setup scoop `
    --installer-commit {{ includeTemplate "ps_quote" .platforms.windows.scoop.installer_commit }} `
    --installer-sha256 {{ includeTemplate "ps_quote" .platforms.windows.scoop.installer_sha256 }} `
    --buckets {{ includeTemplate "ps_quote" (join "," .platforms.windows.scoop.buckets) }} `
    --apps {{ includeTemplate "ps_quote" (join "," .platforms.windows.scoop.apps) }} `
    --winget-duplicates {{ includeTemplate "ps_quote" (join "," .platforms.windows.scoop.winget_duplicates) }}
exit $LASTEXITCODE
