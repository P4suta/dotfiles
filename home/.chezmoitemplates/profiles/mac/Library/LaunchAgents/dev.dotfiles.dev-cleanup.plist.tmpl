<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily: remove long-exited dev containers and run a dangling-only prune.
  Replaces dev-cleanup.timer AND docker-prune.timer — dev-reaper's cleanup subcommand already performs the bounded prune, so a separate prune unit would only duplicate it.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.dotfiles.dev-cleanup</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{ .chezmoi.homeDir }}/.local/bin/dev-reaper</string>
    <string>cleanup</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{ .chezmoi.homeDir }}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>13</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>RunAtLoad</key><false/>
  <key>Nice</key><integer>10</integer>
  <key>LowPriorityIO</key><true/>
  <key>ProcessType</key><string>Background</string>

  <key>StandardOutPath</key>
  <string>{{ .chezmoi.homeDir }}/.local/state/dotfiles/log/dev-reaper.log</string>
  <key>StandardErrorPath</key>
  <string>{{ .chezmoi.homeDir }}/.local/state/dotfiles/log/dev-reaper.log</string>
</dict>
</plist>
