# Public keys herdr-agent loads from 1Password into Herdr's own ssh-agent; rendered from .chezmoidata.json.
# The commit signing key joins them only when the machine-local data sets herdr_agent.load_signing_key.
{{- if and .signing.enabled (dig "herdr_agent" "load_signing_key" false .) }}
{{ .signing.public_key }}
{{- end }}
{{- range .herdr_agent.public_keys }}
{{ . }}
{{- end }}
