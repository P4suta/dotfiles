[tools]
{{- range (concat .tools.common (index .tools .role) | uniq) }}
{{ . | quote }} = "latest"
{{- end }}

# The GitHub source renames the single binary asset `tealdeer-linux-x86_64-musl` to the command `tldr`.
# A single binary release takes `bin`, and an extracted tarball takes `rename_exe`.
"github:tealdeer-rs/tealdeer" = { version = "latest", bin = "tldr" }

[settings]
experimental = true
