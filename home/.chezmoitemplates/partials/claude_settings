{{- /*
  Global Claude Code settings in ~/.claude/settings.json, the same on every profile.

  Delegated development needs a small, targeted deny list.
  Ordinary operations pass.
  Only bypass patterns and destructive actions fail.

  Deny categories, for searching the entries:
  - Destructive filesystem: rm -rf and its variants, find -delete, xargs rm, rmdir
  - Privilege escalation: sudo
  - Network code execution: curl|sh, wget|sh
  - Permission tampering: chmod 777
  - Package installation: brew install, which keeps a human in the loop
  - Secret file reads and writes: .env, id_*, *.key, *.pem, .aws/credentials, .netrc, .npmrc, .kube/config, .docker/config.json, and similar
  - Files the dotfiles manage: direct Write or Edit of .gitconfig, .bashrc, .profile, and .claude/settings.json itself

  - Git hook, signing, and history bypasses: --no-verify, --no-gpg-sign, -c overrides of hooks or signing, force pushes, filter-branch
  The Git guard runs on every host, refuses the same bypasses with the sanctioned next step, and admits the tool-owned operations a prefix rule can't tell apart, such as reset --hard of a clean tree.
  So only the bypasses that no task ever needs stay here as a second check, and conditional Git operations stay with the guard.

  dot_claude/modify_settings.json sets these keys over the file Claude Code last wrote, and an array here, such as permissions.deny, replaces the array the client wrote.
  A runtime change to a key set here, such as `/advisor` changing advisorModel, reverts on the next apply, and every other key the client wrote stays.
  The client keeps permissions.allow and permissions.defaultMode, which the owner sets at a prompt.
  Edit this template and apply to change one of these keys.

  Deny entry syntax:
  - `Bash(<prefix>:*)` denies any Bash invocation that starts with <prefix>, including the arguments after a space.
    Write a rule in prefix form when it must hold.
  */ -}}
{
  "permissions": {
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(rm -R:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -fR:*)",
      "Bash(rm -f:*)",
      "Bash(rm --recursive:*)",
      "Bash(rm --force:*)",
      "Bash(rmdir:*)",
      "Bash(sudo rm:*)",
      "Bash(find * -delete:*)",
      "Bash(find * -exec rm:*)",
      "Bash(xargs rm:*)",
      "Bash(sudo:*)",
      "Bash(curl * | sh:*)",
      "Bash(curl * | bash:*)",
      "Bash(curl * |sh:*)",
      "Bash(curl * |bash:*)",
      "Bash(wget * | sh:*)",
      "Bash(wget * | bash:*)",
      "Bash(chmod 777:*)",
      "Bash(chmod -R 777:*)",
      "Bash(brew install:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git commit --no-gpg-sign:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git -c commit.gpgsign=false:*)",
      "Bash(git -c gpg.format=:*)",
      "Bash(git -c gpg.ssh.program=:*)",
      "Bash(git -c core.hooksPath=:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Read(.env*)",
      "Read(id_rsa*)",
      "Read(id_ed25519*)",
      "Read(id_ecdsa*)",
      "Read(id_dsa*)",
      "Read(*.key)",
      "Read(*.pem)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Read(.aws/credentials)",
      "Read(.aws/config)",
      "Read(.netrc)",
      "Read(.npmrc)",
      "Read(.kube/config)",
      "Read(.docker/config.json)",
      "Read(*.gpg)",
      "Read(*.kdbx)",
      "Write(.env*)",
      "Write(id_rsa*)",
      "Write(id_ed25519*)",
      "Write(id_ecdsa*)",
      "Write(id_dsa*)",
      "Write(*.key)",
      "Write(*.pem)",
      "Write(*.p12)",
      "Write(*.pfx)",
      "Write(.gitconfig)",
      "Write(.bashrc)",
      "Write(.profile)",
      "Write(.claude/settings.json)",
      "Edit(.gitconfig)",
      "Edit(.bashrc)",
      "Edit(.profile)",
      "Edit(.claude/settings.json)"
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "language": "日本語",
  "advisorModel": "opus",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "skipAutoPermissionPrompt": true,
  "autoMemoryEnabled": false
}
