version={{ includeTemplate "partials/sh_quote" .mise.version }}
case "$(uname -s)-$(uname -m)" in
  Linux-x86_64) asset=linux-x64 sha256={{ includeTemplate "partials/sh_quote" (index .mise.sha256 "linux-x64") }} ;;
  Linux-aarch64 | Linux-arm64) asset=linux-arm64 sha256={{ includeTemplate "partials/sh_quote" (index .mise.sha256 "linux-arm64") }} ;;
  Darwin-arm64) asset=macos-arm64 sha256={{ includeTemplate "partials/sh_quote" (index .mise.sha256 "macos-arm64") }} ;;
  Darwin-x86_64) asset=macos-x64 sha256={{ includeTemplate "partials/sh_quote" (index .mise.sha256 "macos-x64") }} ;;
  *) echo "no pinned mise release for $(uname -s)-$(uname -m)" >&2; exit 1 ;;
esac
target="$HOME/.local/bin/mise"
if [ -x "$target" ] && [ "$("$target" --version 2>/dev/null | cut -d ' ' -f 1)" = "$version" ]; then
  exit 0
fi
scope="$(mktemp -d)"
trap 'rm -rf "$scope"' EXIT
curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location --max-time 300 \
  --output "$scope/mise" "https://github.com/jdx/mise/releases/download/v$version/mise-v$version-$asset"
if command -v sha256sum >/dev/null 2>&1; then
  actual="$(sha256sum "$scope/mise" | cut -d ' ' -f 1)"
else
  actual="$(shasum -a 256 "$scope/mise" | cut -d ' ' -f 1)"
fi
if [ "$actual" != "$sha256" ]; then
  echo "mise $version for $asset has SHA-256 $actual, not the pinned $sha256" >&2
  exit 1
fi
chmod 0755 "$scope/mise"
mkdir -p "$HOME/.local/bin"
mv -f "$scope/mise" "$target"
