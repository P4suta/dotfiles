{{- /* chezmoi:modify-template */ -}}
{{- /*
  Claude Code rewrites this file at runtime.
  Each profile sets the keys here over the current file, treats an array as one value, and keeps every other key the client wrote.
  Persistent agent memory stays off.
  docs/agent-memory-migration.md records where its former content lives.
*/ -}}
{{- $current := dict -}}
{{- if trim .chezmoi.stdin -}}{{- $current = fromJson .chezmoi.stdin -}}{{- end -}}
{{- $_ := set $current "hooks" (includeTemplate "partials/without_skill_ops_hooks" (dig "hooks" (dict) $current) | fromJson) -}}
{{- /*
The shell hook refuses recursive disk-usage scans in Bash and PowerShell.
It also refuses file writes through inline interpreters, heredocs, and redirects in Bash.
Claude Code applies a hook's input rewrite, so here the hook runs the exact modern replacement of a legacy command instead of refusing it.
It runs the same runtime binary the git hooks use.
*/ -}}
{{- $tool := ".local/bin/dotfiles" -}}
{{- if eq .profile "windows" }}{{ $tool = ".local/bin/dotfiles.exe" }}{{ end -}}
{{- $hook := dict "type" "command" "onFailure" "block" "command" (printf "%s claude-bash --rewrite" (includeTemplate "partials/sh_quote" (joinPath .chezmoi.homeDir $tool))) -}}
{{- /*
The timing hook sets each shell command timeout from its measured durations.
The tool events keep every group another installer added and replace only their own.
*/ -}}
{{- $timing := dict "type" "command" "command" (printf "%s claude-timing" (includeTemplate "partials/sh_quote" (joinPath .chezmoi.homeDir $tool))) -}}
{{- $hooks := dig "hooks" (dict) $current -}}
{{- $pre := includeTemplate "partials/without_runtime_handlers" (dict "groups" (dig "PreToolUse" (list) $hooks) "suffixes" (list " claude-bash" " claude-bash --rewrite" " claude-timing" " issue-guard")) | fromJson -}}
{{- $_ := set $hooks "PreToolUse" (concat $pre (list (dict "matcher" "Bash|PowerShell" "hooks" (list $hook $timing)))) -}}
{{- $issue := dict "type" "command" "command" (printf "%s issue-guard" (includeTemplate "partials/sh_quote" (joinPath .chezmoi.homeDir $tool))) "onFailure" "block" -}}
{{- $_ := set $hooks "PreToolUse" (concat (dig "PreToolUse" (list) $hooks) (list (dict "matcher" "Edit|Write|MultiEdit|apply_patch" "hooks" (list $issue)))) -}}
{{- range $event := list "PostToolUse" "PostToolUseFailure" -}}
{{-   $groups := includeTemplate "partials/without_runtime_handlers" (dict "groups" (dig $event (list) $hooks) "suffixes" (list " claude-timing")) | fromJson -}}
{{-   $_ := set $hooks $event (concat $groups (list (dict "matcher" "Bash|PowerShell" "hooks" (list $timing)))) -}}
{{- end -}}
{{- /*
A session starts with the verification report, which lists the repository's code shapes that nothing verifies with their next actions.
On Windows it first runs the process-start probe, which hands the agent a refusal while a hung Defender engine stalls every process start.
The stop hook refuses to end a turn while a file it changed holds such a shape.
It also checks the final reply's prose in the owner's language, with at most one continuation.
Both events keep every group another installer added and replace only these.
Unrelated handlers remain in their existing groups.
*/ -}}
{{- $lint := dict "type" "command" "command" (printf "%s lint-hook" (includeTemplate "partials/sh_quote" (joinPath .chezmoi.homeDir $tool))) "onFailure" "block" -}}
{{- $post := includeTemplate "partials/without_runtime_handlers" (dict "groups" (dig "PostToolUse" (list) $hooks) "suffixes" (list " lint-hook")) | fromJson -}}
{{- $_ := set $hooks "PostToolUse" (concat $post (list (dict "matcher" "Edit|Write|MultiEdit|apply_patch" "hooks" (list $lint)))) -}}
{{- $session := list -}}
{{- if eq .profile "windows" -}}
{{-   $session = append $session (dict "type" "command" "command" (printf "%s health --session" (includeTemplate "partials/sh_quote" (joinPath .chezmoi.homeDir $tool)))) -}}
{{- end -}}
{{- $session = append $session (dict "type" "command" "command" (printf "%s assure start" (includeTemplate "partials/sh_quote" (joinPath .chezmoi.homeDir $tool)))) -}}
{{- $stop := dict "type" "command" "command" (printf "%s assure stop --reply-language %s" (includeTemplate "partials/sh_quote" (joinPath .chezmoi.homeDir $tool)) (includeTemplate "partials/reply_language" .)) -}}
{{- range $event := list "SessionStart" "Stop" -}}
{{-   $groups := includeTemplate "partials/without_runtime_handlers" (dict "groups" (dig $event (list) $hooks) "suffixes" (list " health --session" " assure start" " assure stop" " assure stop --reply-language Japanese" " assure stop --reply-language English")) | fromJson -}}
{{-   $own := dict "hooks" (list $stop) -}}
{{-   if eq $event "SessionStart" -}}{{- $own = dict "hooks" $session -}}{{- end -}}
{{-   $_ := set $hooks $event (concat $groups (list $own)) -}}
{{- end -}}
{{- if eq (includeTemplate "partials/skill_ops_experimental" .) "true" -}}
{{- $observe := dict "type" "command" "command" "skill-ops observe --client claude" "timeout" 10 -}}
{{- $_ := set $hooks "PostToolUse" (concat (dig "PostToolUse" (list) $hooks) (list (dict "matcher" "Read|read|Skill|skill|Bash|bash|exec_command" "hooks" (list $observe)))) -}}
{{- $hold := dict "type" "command" "command" "skill-ops stop" "timeout" 10 -}}
{{- $_ := set $hooks "Stop" (concat (dig "Stop" (list) $hooks) (list (dict "hooks" (list $hold)))) -}}
{{- end -}}
{{- $managed := dict "autoMemoryEnabled" false "hooks" $hooks -}}
{{- $notify := dict "type" "command" "command" (printf "%s notifications agent claude" (includeTemplate "partials/sh_quote" (joinPath .chezmoi.homeDir $tool))) "timeout" 1 "async" true -}}
{{- $groups := includeTemplate "partials/without_runtime_handlers" (dict "groups" (dig "Notification" (list) $hooks) "suffixes" (list " notifications agent claude")) | fromJson -}}
{{- $_ := set $hooks "Notification" (concat $groups (list (dict "matcher" "permission_prompt|idle_prompt|elicitation_dialog" "hooks" (list $notify)))) -}}
{{- range $event := list "UserPromptSubmit" "PostToolUse" "PostToolUseFailure" -}}
{{- $groups := includeTemplate "partials/without_runtime_handlers" (dict "groups" (dig $event (list) $hooks) "suffixes" (list " notifications agent claude")) | fromJson -}}
{{- $_ := set $hooks $event (concat $groups (list (dict "hooks" (list $notify)))) -}}
{{- end -}}
{{- $managed = mergeOverwrite $managed (includeTemplate "partials/claude_settings" . | fromJson) -}}
{{ mergeOverwrite $current $managed | toPrettyJson "  " | trim }}

