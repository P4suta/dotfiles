# Windows line endings break scripts, hooks, and templates on Linux.
* text=auto eol=lf
# Preserve original JSON bytes for retrieved indexes and vendor fixtures.
crates/dotfiles/tests/fixtures/*-bootstrap-index.json -text
xtask/schema/njutest/*.json -text
xtask/tests/fixtures/njutest/*.json -text
# A fuzzer reads each corpus entry byte for byte, so no conversion or text check may change it.
fuzz/corpus/** binary
xtask/proofs/fuzz-fixture/corpus/** binary
# Compressed consumer schemas keep their original bytes and both recorded digests.
schemas/vendor/*.gz binary
# The copyediting fixtures and tests hold real Chinese and Japanese text in the language they check.
crates/prose/tests/fixtures/copyedit/** dotguard-lang=off
crates/prose/tests/copyedit.rs dotguard-lang=off
crates/prose/tests/editorial.rs dotguard-lang=off
home/dot_config/prose/nlp/test_annotations.py dotguard-lang=off
fuzz/corpus/copyedit_input/** dotguard-lang=off
# Keep prepared pulse code modulation bytes identical to their fixed manifest.
home/dot_config/dotfiles/notifications/audio/*.wav binary
# The Japanese word rules list the Chinese terms they refuse, so the language guard must not refuse the list itself.
home/dot_config/prose/japanese.toml dotguard-lang=off
