{{- /* chezmoi:modify-template */ -}}
{{- /*
  Claude Code rewrites this file at runtime, so each profile sets the keys here over the current file, an array as one value, and keeps every other key the client wrote.
  Persistent agent memory stays off; docs/agent-memory-migration.md records where its former content lives.
*/ -}}
{{- $current := dict -}}
{{- if trim .chezmoi.stdin -}}{{- $current = fromJson .chezmoi.stdin -}}{{- end -}}
{{- /* The shell hook refuses recursive disk-usage scans in Bash and PowerShell, and file writes through inline interpreters, heredocs, and redirects in Bash; it runs the same xtask binary the git hooks use. */ -}}
{{- $tool := ".local/bin/dotfiles-xtask" -}}
{{- if eq .profile "windows" }}{{ $tool = ".local/bin/dotfiles-xtask.exe" }}{{ end -}}
{{- $hook := dict "type" "command" "command" (printf "%s claude-bash" (includeTemplate "sh_quote" (joinPath .chezmoi.homeDir $tool))) -}}
{{- $hooks := dict "PreToolUse" (list (dict "matcher" "Bash|PowerShell" "hooks" (list $hook))) -}}
{{- $managed := dict "autoMemoryEnabled" false "hooks" $hooks -}}
{{- if eq .profile "wsl" -}}
{{- $managed = mergeOverwrite $managed (includeTemplate "profiles/wsl/dot_claude/settings.json.tmpl" (merge (dict) . (index .platforms .profile)) | fromJson) -}}
{{- end -}}
{{ mergeOverwrite $current $managed | toPrettyJson "  " | trim }}

