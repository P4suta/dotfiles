{{- /* chezmoi:modify-template */ -}}
{{- /*
  Claude Code rewrites this file at runtime, so each profile owns only the keys set here and keeps every other key the client wrote.
  Persistent agent memory stays off; docs/agent-memory-migration.md records where its former content lives.
*/ -}}
{{- $current := dict -}}
{{- if trim .chezmoi.stdin -}}{{- $current = fromJson .chezmoi.stdin -}}{{- end -}}
{{- $managed := dict "autoMemoryEnabled" false -}}
{{- if eq .profile "wsl" -}}
{{- $managed = includeTemplate "profiles/wsl/dot_claude/settings.json.tmpl" (merge (dict) . (index .platforms .profile)) | fromJson -}}
{{- end -}}
{{ merge $managed $current | toPrettyJson "  " | trim }}

