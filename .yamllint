# Baseline for every YAML file in this repository.
extends: default

rules:
# GitHub workflows omit `---`.
  document-start: disable
  comments-indentation: disable

# YAML 1.1 reads the GitHub Actions `on:` key as true.
  truthy:
    check-keys: false

  line-length: disable

  comments:
    min-spaces-from-content: 1

# Ansible writes `{{ value }}`.
  braces:
    max-spaces-inside: 1

# Quote file modes so YAML 1.1 keeps them as strings.
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
