# Paths chezmoi does not track: neither applied to $HOME nor kept in git.
# The shared host state patterns live in host-state-ignore.

# The dotguard crate: tracked in git, built to ~/.local/bin/dotguard by run_onchange_after_setup-guard.sh, never copied into $HOME as source.
guard/**

# Directories that only hold another profile's targets in the unified source; ignoring them keeps this home from gaining empty trees or changed permissions.
.config/fcitx5
.config/kitty
.config/systemd
.config/wezterm
.local/share
AppData
Documents
