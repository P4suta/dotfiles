# Login environment for terminals, SSH, and editors that the desktop launches.
# PATH lives here because path_helper in /etc/zprofile rebuilds PATH before this file runs, discarding prefixes from .zshenv.

# Homebrew comes first so later lines prepend in front of it.
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# shellcheck source=dot_config/shell/ssh-agent.sh
if [ -r "${HOME}/.config/shell/ssh-agent.sh" ]; then
  . "${HOME}/.config/shell/ssh-agent.sh"
fi

# Desktop apps and remote extension hosts get the shims without an interactive shell.
# ~/.local/bin precedes Homebrew so every shell resolves the git wrapper.
export PATH="${HOME}/.local/share/mise/shims:${HOME}/.opam/{{ .ocaml.switch }}/bin:${HOME}/.local/bin:${PATH}"
