# Login environment for terminals, SSH, and desktop-launched editors.
# PATH lives here because path_helper rebuilds it before this file runs and discards .zshenv prefixes.

# Homebrew first, so later lines prepend before it.
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# shellcheck source=dot_config/shell/ssh-agent.sh
if [ -r "${HOME}/.config/shell/ssh-agent.sh" ]; then
  . "${HOME}/.config/shell/ssh-agent.sh"
fi

# Desktop apps and remote extension hosts need the shims without an interactive shell.
# ~/.local/bin precedes Homebrew so the git wrapper wins.
export PATH="${HOME}/.local/share/mise/shims:${HOME}/.opam/{{ .ocaml.switch }}/bin:${HOME}/.local/bin:${PATH}"
