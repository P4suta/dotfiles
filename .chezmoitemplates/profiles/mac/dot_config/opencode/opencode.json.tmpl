{{- /*
  Declare Context7 only on a local workstation with the 1Password app bundle.
*/ -}}
{{- $isLocal := not (or (env "SSH_CONNECTION") (env "SSH_CLIENT") (env "SSH_TTY")) -}}
{{- $app := default "/Applications/1Password.app" (env "DOTFILES_ONEPASSWORD_APP") -}}
{{- $hasOnePassword := and (eq .chezmoi.os "darwin") $isLocal (stat $app) -}}
{{- /* Declare the gcloud server only where the gcp skill installed its bundle, and run it with the mise Node. */ -}}
{{- $gcloudMcp := joinPath .chezmoi.homeDir ".local/share/gcloud-mcp/node_modules/@google-cloud/gcloud-mcp/dist/bundle.js" -}}
{{- $node := joinPath .chezmoi.homeDir ".local/share/mise/installs/node/latest/bin" -}}
{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "formatter": true,
  "lsp": true,
  "permission": {
    "*": "allow",
    "edit": "allow",
    "bash": {
      "*": "allow",
      "sudo *": "deny",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -fr /": "deny",
      "rm -fr /*": "deny",
      "rm -rf ~": "deny",
      "rm -rf ~/*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "curl * | sh": "deny",
      "curl * | bash": "deny",
      "wget * | sh": "deny",
      "wget * | bash": "deny"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GH_MCP_TOKEN}",
        "X-MCP-Toolsets": "repos,issues,pull_requests,notifications",
        "X-MCP-Readonly": "true"
      },
      "oauth": false,
      "enabled": true
    }{{ if stat $gcloudMcp }},
    "gcloud": {
      "type": "local",
      "command": [{{ joinPath $node "node" | toJson }}, {{ $gcloudMcp | toJson }}],
      "environment": {
        "CLOUDSDK_CORE_DISABLE_PROMPTS": "1",
        "PATH": {{ printf "/opt/homebrew/share/google-cloud-sdk/bin:%s:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin" $node | toJson }}
      },
      "enabled": true,
      "timeout": 30000
    }{{ end }}
  }{{ if $hasOnePassword }},
  "plugin": ["@upstash/context7-opencode"]{{ end }}
}
