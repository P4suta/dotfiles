# dev-reaper configuration — read by ~/.local/bin/dev-reaper.
# launchd has no EnvironmentFile directive, so the script sources this file itself — a change takes effect on the next run with no launchctl reload.
# Managed by chezmoi (dot_config/dev-reaper/config).
# Change a value and run `chezmoi apply`.
# (Editing ~/.config/dev-reaper/config directly works for a quick test, but the next `chezmoi apply` restores this managed version.)

# Operating mode: log | stop | full
#   log  = detect and journal only; never touch a container
#   stop = stop idle containers (no removal)
#   full = stop + remove long-exited containers + safe (dangling) prune
# Roll back at any time by setting this to `log` and re-applying.
DEV_REAPER_MODE=full

# Continuous idle before a running container is stopped (seconds).
# Default 2h.
DEV_REAPER_IDLE_STOP_SECONDS=7200

# Remove dev containers that have been `exited` at least this long (seconds).
# 7d.
DEV_REAPER_EXITED_REMOVE_SECONDS=604800

# CPU% below which a sample counts as "quiet".
DEV_REAPER_THRESHOLD_PCT=3

# Grace after (re)start before a container is eligible to be reaped (seconds).
# 30m.
DEV_REAPER_MIN_UPTIME_SECONDS=1800

# A container counts as active if an exec/attach happened within this window.
# 2h.
DEV_REAPER_EXEC_QUIET_SECONDS=7200

# Which containers count as "dev containers".
DEV_REAPER_SELECT_LABEL=com.docker.compose.service=dev

# Opt-out label: containers carrying this are never stopped or removed.
DEV_REAPER_KEEP_LABEL=dev-reaper.keep=true

# Space-separated compose project names to exclude entirely (e.g. "register foo").
DEV_REAPER_EXCLUDE=""

# Build cache to retain on prune.
DEV_REAPER_BUILDER_RESERVED=10GB

# Desktop notifications (1=on, 0=off).
# The audit log always goes to ~/.local/state/dotfiles/log/dev-reaper.log.
DEV_REAPER_NOTIFY=1
