# lazygit, themed from [palette].
#
# Deployed to ~/.config/lazygit even though lazygit itself looks in ~/Library/Application Support/lazygit: the platform path is a symlink back here (Library/Application Support/symlink_lazygit.tmpl), the same arrangement Nushell needs.
# Keeping every config under ~/.config is the invariant; the symlink is what makes a platform-convention tool honour it.
gui:
  nerdFontsVersion: "3"
  showDivergenceFromBaseBranch: arrowAndNumber
  theme:
    activeBorderColor: ["{{ .palette.blue }}", bold]
    inactiveBorderColor: ["{{ .palette.surface }}"]
    searchingActiveBorderColor: ["{{ .palette.yellow }}", bold]
    optionsTextColor: ["{{ .palette.blue }}"]
    selectedLineBgColor: ["{{ .palette.bg_highlight }}"]
    cherryPickedCommitFgColor: ["{{ .palette.bg }}"]
    cherryPickedCommitBgColor: ["{{ .palette.magenta }}"]
    markedBaseCommitFgColor: ["{{ .palette.bg }}"]
    markedBaseCommitBgColor: ["{{ .palette.yellow }}"]
    unstagedChangesColor: ["{{ .palette.red }}"]
    defaultFgColor: ["{{ .palette.fg }}"]

git:
# The same pager as `git diff`, so a diff looks identical whether it is read in lazygit or in the shell.
# Without this lazygit falls back to plain git output and the two disagree about what a diff looks like.
  paging:
    colorArg: always
    pager: delta --dark --paging=never
