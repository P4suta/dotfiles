<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Weekly reconciliation of the Homebrew system tier and the desktop assets, replacing dotfiles-desktop-refresh.timer.

  `brew bundle` is additive and idempotent, so a missed week costs nothing and a run on an already-current machine is a no-op.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.dotfiles.desktop-refresh</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{ .chezmoi.homeDir }}/.local/bin/dotfiles-refresh-desktop</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{ .chezmoi.homeDir }}/.local/share/mise/shims:{{ .chezmoi.homeDir }}/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>0</integer>
    <key>Hour</key><integer>12</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>RunAtLoad</key><false/>
  <key>Nice</key><integer>10</integer>
  <key>LowPriorityIO</key><true/>
  <key>ProcessType</key><string>Background</string>

  <key>StandardOutPath</key>
  <string>{{ .chezmoi.homeDir }}/.local/state/dotfiles/log/desktop-refresh.log</string>
  <key>StandardErrorPath</key>
  <string>{{ .chezmoi.homeDir }}/.local/state/dotfiles/log/desktop-refresh.log</string>
</dict>
</plist>
