<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Every 5 minutes: stop dev containers that have gone idle.
  Replaces dev-reaper.timer.

  Self-gating: dev-reaper exits 0 immediately when the Docker socket is not reachable, so this agent is harmless on a machine where OrbStack is not running (which, on a laptop, is most of the time).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.dotfiles.dev-reaper</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{ .chezmoi.homeDir }}/.local/bin/dev-reaper</string>
    <string>reap</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{ .chezmoi.homeDir }}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StartInterval</key><integer>300</integer>
  <key>ThrottleInterval</key><integer>120</integer>
  <key>RunAtLoad</key><false/>
  <key>Nice</key><integer>10</integer>
  <key>LowPriorityIO</key><true/>
  <key>ProcessType</key><string>Background</string>

  <key>StandardOutPath</key>
  <string>{{ .chezmoi.homeDir }}/.local/state/dotfiles/log/dev-reaper.log</string>
  <key>StandardErrorPath</key>
  <string>{{ .chezmoi.homeDir }}/.local/state/dotfiles/log/dev-reaper.log</string>
</dict>
</plist>
