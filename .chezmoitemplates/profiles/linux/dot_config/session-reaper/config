# session-reaper configuration — read by the systemd unit as an EnvironmentFile.
# Managed by chezmoi (dot_config/session-reaper/config).
# Change a value and run `chezmoi apply` (editing ~/.config/session-reaper/config directly works for a quick test, but the next apply restores this managed version).

# Operating mode: report | reap
#   report = detect + journal/notify only; never kill (dry-run)
#   reap   = auto-kill tier A (stopped + orphaned, grace-confirmed).
# Tier B (running orphans) is ALWAYS report-only regardless of mode.
# Roll back any time by setting this to `report` and re-applying.
SESSION_REAPER_MODE=reap

# Tier A: a stopped+orphaned process must be at least this old (seconds) before it is eligible at all.
# Default 1h.
SESSION_REAPER_STOPPED_MIN_AGE=3600

# Tier A: and must have been observed stopped+orphaned for at least this long (i.e. across a prior run) before it is killed — guards against sampling a process mid-transition.
# Default 30m.
SESSION_REAPER_GRACE_SECONDS=1800

# Tier B: report (never kill) running orphans with no controlling tty that are older than this.
# Default 3d.
SESSION_REAPER_RUNNING_MIN_AGE=259200

# comm names never touched, even in tier A (ERE, anchored with ^...$).
SESSION_REAPER_ALLOW_REGEX=^(tmux.*|screen.*|sshd|systemd|systemd-.*|dbus-.*|pipewire.*|wireplumber|pulseaudio|gvfsd.*|ssh-agent|gpg-agent|gnome-keyring-d|code-.*|session-reaper)$

# Desktop notifications (1=on, 0=off).
# The audit log always goes to journald.
SESSION_REAPER_NOTIFY=1
