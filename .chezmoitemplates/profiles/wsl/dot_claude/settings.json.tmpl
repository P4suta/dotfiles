{{- /*
  Global Claude Code permissions in ~/.claude/settings.json.

  Delegated development needs a small, targeted deny list.
  Ordinary operations pass.
  Only bypass patterns and destructive actions fail.

  Deny categories, for searching the entries:
  - Destructive filesystem: rm -rf and its variants, find -delete, xargs rm, rmdir
  - Privilege escalation: sudo
  - Git history rewrites: force push, hard reset, rebase -i, filter-branch, update-ref -d, clean -fd
  - Git signing bypass: --no-verify, --no-gpg-sign, `-c commit.gpgsign=false`, `-c core.hooksPath=`, `git config commit.gpgsign false`, and similar
  - Network code execution: curl|sh, wget|sh
  - Permission tampering: chmod 777
  - Package installation: brew install, which keeps a human in the loop
  - Secret file reads and writes: .env, id_*, *.key, *.pem, .aws/credentials, .netrc, .npmrc, .kube/config, .docker/config.json, and similar
  - Files the dotfiles manage: direct Write or Edit of .gitconfig, .bashrc, .profile, and .claude/settings.json itself

  Left out of the deny list on purpose:
  - `Bash(git commit:*)` would block every commit in delegated development.
    Only the signing bypass flags fail, and the post-commit hook signs every commit.
  - `Bash(git config *)` covers too much.
    Only the signing keys fail.
  - `Bash(git reset:*)` would block the useful soft and mixed resets.
    Only `--hard` fails.

  On the JSON layout, Claude Code rewrites this file in a canonical form, with its own key order and without blank lines, and `/advisor` adds advisorModel.
  This template follows that output to keep drift small:
  1. The permissions block comes first.
  2. The other top-level keys come last: language, advisorModel, theme, and skipAutoPermissionPrompt.
  3. The deny array holds no blank lines.
  To change advisorModel, edit this template with `chezmoi edit ~/.claude/settings.json` and run `chezmoi apply`.
  The next apply reverts a runtime `/advisor` change.

  Deny entry syntax:
  - `Bash(<prefix>:*)` denies any Bash invocation that starts with <prefix>, including the arguments after a space.
    Write a rule in prefix form when it must hold.
  */ -}}
{
  "permissions": {
    "allow": [],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(rm -R:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -fR:*)",
      "Bash(rm -f:*)",
      "Bash(rm --recursive:*)",
      "Bash(rm --force:*)",
      "Bash(rmdir:*)",
      "Bash(sudo rm:*)",
      "Bash(find * -delete:*)",
      "Bash(find * -exec rm:*)",
      "Bash(xargs rm:*)",
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase -i:*)",
      "Bash(git rebase --interactive:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(git update-ref -d:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git checkout --:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git commit --no-gpg-sign:*)",
      "Bash(git -c commit.gpgsign=false:*)",
      "Bash(git -c gpg.format=:*)",
      "Bash(git -c core.hooksPath=:*)",
      "Bash(git -c gpg.ssh.program=:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git config commit.gpgsign false:*)",
      "Bash(git config --global commit.gpgsign false:*)",
      "Bash(git config --unset commit.gpgsign:*)",
      "Bash(git config --unset gpg.format:*)",
      "Bash(git config --unset gpg.ssh.allowedSignersFile:*)",
      "Bash(git config core.hooksPath:*)",
      "Bash(curl * | sh:*)",
      "Bash(curl * | bash:*)",
      "Bash(curl * |sh:*)",
      "Bash(curl * |bash:*)",
      "Bash(wget * | sh:*)",
      "Bash(wget * | bash:*)",
      "Bash(chmod 777:*)",
      "Bash(chmod -R 777:*)",
      "Bash(brew install:*)",
      "Read(.env*)",
      "Read(id_rsa*)",
      "Read(id_ed25519*)",
      "Read(id_ecdsa*)",
      "Read(id_dsa*)",
      "Read(*.key)",
      "Read(*.pem)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Read(.aws/credentials)",
      "Read(.aws/config)",
      "Read(.netrc)",
      "Read(.npmrc)",
      "Read(.kube/config)",
      "Read(.docker/config.json)",
      "Read(*.gpg)",
      "Read(*.kdbx)",
      "Write(.env*)",
      "Write(id_rsa*)",
      "Write(id_ed25519*)",
      "Write(id_ecdsa*)",
      "Write(id_dsa*)",
      "Write(*.key)",
      "Write(*.pem)",
      "Write(*.p12)",
      "Write(*.pfx)",
      "Write(.gitconfig)",
      "Write(.bashrc)",
      "Write(.profile)",
      "Write(.claude/settings.json)",
      "Edit(.gitconfig)",
      "Edit(.bashrc)",
      "Edit(.profile)",
      "Edit(.claude/settings.json)"
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "language": "日本語",
  "advisorModel": "opus",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "skipAutoPermissionPrompt": true
}
