[user]
	name = {{ .git.name | quote }}
	email = {{ .git.email | quote }}

[core]
	sshCommand = ssh.exe
	pager = delta
	# Every repository normalizes text to LF unless its own attributes say otherwise.
	attributesFile = ~/.config/git/attributes
{{- if .signing.enabled }}
	# One hook directory enforces signing in every repository, including existing clones.
	# The hooks live in dot_config/git/hooks/ and run each repository's own lefthook configuration, so no repository installs lefthook hooks.
	hooksPath = ~/.config/git/hooks
{{- end }}

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	side-by-side = true
	syntax-theme = Monokai Extended

[diff]
	colorMoved = default

[pull]
	rebase = true

[init]
	defaultBranch = main

[alias]
	dft = -c diff.external=difft diff
	co-jj = "!f() { jj git init --colocate; }; f"

{{ if .signing.enabled -}}
[gpg]
	format = ssh
[gpg "ssh"]
	# Signing and verification run the Windows OpenSSH ssh-keygen.
	# That binary reaches the 1Password SSH agent that WSL shares with Windows.
	program = {{ joinPath .chezmoi.homeDir ".local/bin/dotfiles-wsl-ssh-keygen" | quote }}
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[user]
	signingkey = {{ printf "key::%s" (includeTemplate "signing_pubkey" . | trim) | quote }}
{{- end }}
