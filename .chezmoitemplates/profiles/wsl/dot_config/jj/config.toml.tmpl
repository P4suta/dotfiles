[user]
name  = "{{ .git.name }}"
email = "{{ .git.email }}"

[ui]
default-command = ["log"]
diff-formatter = ["difft", "--color=always", "--display=inline", "$left", "$right"]
pager = "delta --paging=always"
color = "always"
progress-indicator = true

[git]
push-bookmark-prefix = "push-"

[remotes.origin]
# 旧 git.auto-local-bookmark = true の後継(jj 0.38+)。
# リモートから取った bookmark を自動でローカル追跡する。
auto-track-bookmarks = "*"

[revset-aliases]
'closest_bookmark(to)' = 'heads(::to & bookmarks())'
'mine_unpushed' = 'mine() ~ ::trunk()'

[aliases]
l        = ["log"]
ll       = ["log", "-r", "::@"]
d        = ["diff"]
s        = ["status"]
n        = ["new"]
e        = ["edit"]
ab       = ["abandon"]
push     = ["git", "push"]
pull     = ["git", "fetch", "--all-remotes"]
colocate = ["git", "init", "--colocate"]
f        = ["git", "fetch", "--all-remotes"]

[signing]
{{- if .signing.enabled }}
behavior = "keep"
backend = "ssh"
key = {{ includeTemplate "signing_pubkey" . | trim | quote }}
# Windows OpenSSH の ssh-keygen で署名検証する (gitconfig と統一)。
backends.ssh.program = {{ joinPath .chezmoi.homeDir ".local/bin/dotfiles-wsl-ssh-keygen" | quote }}
{{- else }}
behavior = "drop"
{{- end }}

[templates]
log_oneline = '''
commit_id.shortest(8) ++ " " ++
if(description, description.first_line(), "(no description)")
'''
