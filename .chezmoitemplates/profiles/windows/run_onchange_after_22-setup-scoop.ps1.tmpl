$ErrorActionPreference = 'Stop'
& {{ includeTemplate "ps_quote" (joinPath .chezmoi.homeDir ".local/bin/dotctl.exe") }} setup scoop `
    --installer-commit {{ includeTemplate "ps_quote" .scoop.installer_commit }} `
    --installer-sha256 {{ includeTemplate "ps_quote" .scoop.installer_sha256 }} `
    --buckets {{ includeTemplate "ps_quote" (join "," .scoop.buckets) }} `
    --apps {{ includeTemplate "ps_quote" (join "," .scoop.apps) }} `
    --winget-duplicates {{ includeTemplate "ps_quote" (join "," .scoop.winget_duplicates) }}
exit $LASTEXITCODE
