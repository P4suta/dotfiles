/-!
Generated by `just gen` from the production Rust contrast expressions.
Kani checks unsigned arithmetic safety, so these natural-number definitions preserve their values.
-/

namespace Dotfiles.Contrast.Source

def FLARE : Nat := 5000000000
def LEAST_NUMERATOR : Nat := 9
def LEAST_DENOMINATOR : Nat := 2
def MILLIS : Nat := 1000
def MAX_LINEAR : Nat := 10000000
def MAX_LUMINANCE : Nat := (MAX_LINEAR * 10000)
def MAX_RATIO : Nat := (21 * MILLIS)

def ordered_luminances (first : Nat) (second : Nat) : Nat × Nat :=
  let first := (FLARE + first); let second := (FLARE + second); (if (decide (first ≥ second)) then (first, second) else (second, first))

def keeps_least_contrast (first : Nat) (second : Nat) : Bool :=
  let (lighter, darker) := (ordered_luminances first second); (decide ((LEAST_DENOMINATOR * lighter) ≥ (LEAST_NUMERATOR * darker)))

def ratio_ordered (lighter : Nat) (darker : Nat) : Nat :=
  ((lighter * MILLIS) / darker)

def ratio_luminances (first : Nat) (second : Nat) : Nat :=
  let (lighter, darker) := (ordered_luminances first second); (ratio_ordered lighter darker)

end Dotfiles.Contrast.Source
