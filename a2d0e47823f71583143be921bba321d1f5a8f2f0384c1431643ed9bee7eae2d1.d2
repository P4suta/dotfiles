vars: {
  d2-config: {
    layout-engine: elk
    pad: 40
    theme-overrides: {
      N1: "#000000"
      N2: "#000000"
      N3: "#000000"
      N4: "#FFFFFF"
      N5: "#FFFFFF"
      N6: "#FFFFFF"
      N7: "#FFFFFF"
      B1: "#000000"
      B2: "#000000"
      B3: "#FFFFFF"
      B4: "#FFFFFF"
      B5: "#FFFFFF"
      B6: "#FFFFFF"
      AA2: "#000000"
      AA4: "#FFFFFF"
      AA5: "#FFFFFF"
      AB4: "#FFFFFF"
      AB5: "#FFFFFF"
    }
  }
}

direction: down
title: "Proposed flow: Verify Mise Java pins" {
  shape: text
  near: top-center
}
manifest: "Offered Git revision\nDeclared Mise Java pin"
catalog: "Mise SDK catalog\nPublished Java versions"
lookup: "Renovate lookup\nResolve the declared distribution"
binding: "Manifest pin and\ncatalog result match?" {
  shape: diamond
}
continue: "Continue required\npush checks"
refuse: "Refuse the push\nReport the unresolved pin"
manifest -> lookup: "names the SDK pin"
catalog -> lookup: "provides release metadata"
manifest -> binding: "binds the source revision"
lookup -> binding: "returns the checked version"
binding -> continue: "matching current release"
binding -> refuse: "missing, mismatched, or outdated"
key: "Rectangles: sources, checks, or outcomes\nDiamond: required decision\nArrows: labeled information or control" {
  shape: text
  near: bottom-center
}
